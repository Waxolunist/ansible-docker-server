discovery.docker "containers" {
	host             = "tcp://socket-proxy:2375"
	refresh_interval = "15s"
}

discovery.relabel "containers" {
	targets = []

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "logstream"
	}
}

loki.source.docker "containers" {
	host             = "tcp://socket-proxy:2375"
	targets          = discovery.docker.containers.targets
	relabel_rules    = discovery.relabel.containers.rules
	refresh_interval = "15s"
	labels           = {
		host   = "VPS",
		source = "docker",
	}
	forward_to = [loki.process.containers.receiver]
}

loki.process "containers" {
	stage.match {
		selector = "{container=\"web_timescaledb\"}"

		stage.regex {
			expression = "(?i)(?P<pg_level>LOG|FATAL|ERROR|WARNING|NOTICE|DEBUG\\d?):\\s+"
		}

		stage.labels {
			values = {pg_level = ""}
		}
	}

	stage.match {
		selector = "{container=\"authelia\"}"

		stage.replace {
			expression = "( stack=\"(?:[^\"\\\\]|\\\\.)*\")"
			replace    = ""
		}

		stage.logfmt {
			mapping = {level = ""}
		}

		stage.labels {
			values = {level = ""}
		}
	}

	stage.match {
		selector = "{container=\"web_prometheus\"}"

		stage.logfmt {
			mapping = {level = ""}
		}

		stage.template {
			source   = "level"
			template = "{{ ToLower .Value }}"
		}

		stage.labels {
			values = {level = ""}
		}
	}

	stage.match {
		selector = "{container!~\"web_timescaledb|authelia|web_prometheus\"}"

		stage.regex {
			expression = "(?i)(?:\\b(?:level|lvl|severity)\"?\\s*[=:]\\s*\"?|\\[)(?P<level_raw>trace|debug|info|notice|warn|warning|error|err|fatal|critical|crit|panic)\\b"
		}

		stage.template {
			source   = "level"
			template = "{{ with .level_raw }}{{ $l := ToLower . }}{{ if eq $l \"warn\" }}warning{{ else if eq $l \"err\" }}error{{ else if or (eq $l \"fatal\") (eq $l \"crit\") (eq $l \"panic\") }}critical{{ else }}{{ $l }}{{ end }}{{ end }}"
		}

		stage.labels {
			values = {level = ""}
		}
	}

	forward_to = [loki.write.loki.receiver]
}

loki.relabel "journal" {
	forward_to = []

	rule {
		action = "labeldrop"
		regex  = "job"
	}

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["unit"]
		regex         = "session-[0-9]+\\.scope"
		target_label  = "unit"
		replacement   = "session.scope"
	}

	rule {
		source_labels = ["__journal_syslog_identifier"]
		target_label  = "syslog_identifier"
	}

	rule {
		source_labels = ["syslog_identifier"]
		target_label  = "service_name"
	}

	rule {
		source_labels = ["unit"]
		regex         = "(.+)\\.service"
		target_label  = "service_name"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "[012]"
		target_label  = "level"
		replacement   = "critical"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "3"
		target_label  = "level"
		replacement   = "error"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "4"
		target_label  = "level"
		replacement   = "warning"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "5"
		target_label  = "level"
		replacement   = "notice"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "6"
		target_label  = "level"
		replacement   = "info"
	}

	rule {
		source_labels = ["__journal_priority"]
		regex         = "7"
		target_label  = "level"
		replacement   = "debug"
	}
}

loki.process "journal" {
	stage.match {
		selector = "{unit=\"ssh.service\"} |~ \"^Accepted \""

		stage.regex {
			expression = "^Accepted (?P<ssh_method>\\S+) for (?P<ssh_user>\\S+) from (?P<address>\\S+) port \\d+ ssh2(?:: \\S+ (?P<ssh_key>SHA256:\\S+))?"
		}

		stage.regex {
			source     = "address"
			expression = "^(?:(?P<wireguard>10\\.8\\.0\\.)|(?P<tls_tunnel>172\\.20\\.0\\.))"
		}

		stage.template {
			source   = "ssh_origin"
			template = "{{ if .wireguard }}wireguard{{ else if .tls_tunnel }}tls-tunnel{{ else }}internet{{ end }}"
		}

		stage.labels {
			values = {ssh_user = "", ssh_method = "", ssh_key = "", ssh_origin = ""}
		}

		stage.metrics {
			metric.counter {
				name              = "ssh_logins_total"
				description       = "Accepted SSH logins by user, method, key and origin"
				match_all         = true
				action            = "inc"
				max_idle_duration = "8760h"
			}
		}

		stage.label_drop {
			values = ["ssh_user", "ssh_method", "ssh_key", "ssh_origin"]
		}
	}

	forward_to = [loki.write.loki.receiver]
}

loki.source.journal "journal" {
	path          = "/var/log/journal"
	max_age       = "12h"
	relabel_rules = loki.relabel.journal.rules
	labels        = {
		host   = "VPS",
		source = "journal",
	}
	forward_to = [loki.process.journal.receiver]
}

loki.source.file "traefik_access" {
	targets = [{
		__path__     = "/var/log/traefik/access.log",
		host         = "VPS",
		source       = "file",
		service_name = "traefik-access",
	}]
	forward_to = [loki.process.traefik_access.receiver]
}

loki.process "traefik_access" {
	stage.json {
		expressions = {
			client = "ClientHost",
			user   = "ClientUsername",
			status = "DownstreamStatus",
			router = "RouterName",
			start  = "StartUTC",
		}
	}

	stage.timestamp {
		source = "start"
		format = "RFC3339Nano"
	}

	stage.regex {
		source     = "client"
		expression = "^(?P<private>10\\.|127\\.|192\\.168\\.|172\\.(?:1[6-9]|2[0-9]|3[01])\\.|::1$)"
	}

	stage.regex {
		source     = "user"
		expression = "^(?P<authenticated>[^-].*|-.+)$"
	}

	stage.regex {
		source     = "status"
		expression = "^(?P<status_digit>[1-5])"
	}

	stage.template {
		source   = "own"
		template = "{{ if or .private .authenticated }}true{{ else }}false{{ end }}"
	}

	stage.template {
		source   = "status_class"
		template = "{{ with .status_digit }}{{ . }}xx{{ end }}"
	}

	stage.labels {
		values = {own = "", status_class = "", router = ""}
	}

	stage.label_drop {
		values = ["filename"]
	}

	stage.replace {
		expression = "\"RequestPath\":\"(?:[^\"\\\\?]|\\\\.)*(\\?(?:[^\"\\\\]|\\\\.)*)\""
		replace    = "?*"
	}

	stage.replace {
		expression = "\"ClientUsername\":\"([^\"-][^\"]*|-[^\"]+)\""
		replace    = "authenticated"
	}

	stage.replace {
		expression = "(\"(?:ClientAddr|ClientPort|GzipRatio|OriginContentSize|Overhead|RequestAddr|RequestCount|RequestPort|RetryAttempts|ServiceAddr|ServiceURL|StartLocal|StartUTC|level|msg)\":(?:\"(?:[^\"\\\\]|\\\\.)*\"|[-+.0-9eE]+),)"
		replace    = ""
	}

	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
