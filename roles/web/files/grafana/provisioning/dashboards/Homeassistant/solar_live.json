      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- data_solar_production is the PV production counter (kWh): the inverter's\n-- AC counter without battery charge/discharge since the Modbus switch, dips\n-- dropped (TASK-085). Production since the start of the range = the counter\n-- minus the last one before the range, or the first one in it.\nselect time,\n       energy - coalesce(\n         (select max(energy) from data_solar_production\n          where time < $__timeFrom() and time >= $__timeFrom()::timestamptz - interval '7 days'),\n         first_value(energy) over (order by time)) as energy\nfrom data_solar_production\nwhere $__timeFilter(time)\norder by time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
