                        "rawSql": "select time, house_kw as \"House\", grid_kw as \"Grid\", pv_kw as \"PV\",\n       battery_kw as \"Battery\", goe_kw as \"Car charger\",\n       battery_soc as \"Battery SOC\"\nfrom data_power_live\nwhere $__timeFilter(time)\norder by time;",
