                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "hideTimeOverride": true,
                "timeFrom": "now/d"
              },
              "transformations": []
            }
          },
          "description": "PV production since midnight: the inverter's AC counter plus battery charge minus discharge (data_solar_production), updated every 5 minutes.",
          "id": 4,
