                          "kind": "ElementReference",
                          "name": "panel-2"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 4,
                  "rowHeight": 140,
                  "rowHeightMode": "custom"
                }
              },
              "title": "In the picked range"
            }
          },
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "standard",
                  "fillScreen": false,
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-3"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-4"
                        }
                      }
                    },
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-5"
                        }
                      }
                    }
                  ],
                  "maxColumnCount": 1,
                  "rowHeightMode": "tall"
                }
              },
              "title": "Consumption"
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": false,
