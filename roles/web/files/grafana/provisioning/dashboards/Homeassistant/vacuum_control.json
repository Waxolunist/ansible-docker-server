{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "vacuum-control"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "roborock"
                      },
                      "group": "yesoreyeram-infinity-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "columns": [
                          {
                            "selector": "id",
                            "text": "id",
                            "type": "number"
                          },
                          {
                            "selector": "name",
                            "text": "name",
                            "type": "string"
                          }
                        ],
                        "filters": [],
                        "format": "table",
                        "parser": "backend",
                        "root_selector": "",
                        "source": "url",
                        "type": "json",
                        "url": "@@ROBOROCK_URL@@/routines",
                        "url_options": {
                          "data": "",
                          "method": "GET"
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "One button per routine defined in the Roborock app, read from the vacuum controller's /routines (cached for 5 minutes). A click starts the routine through the Roborock cloud; Stop and Return to dock go to the vacuum directly.",
          "id": 1,
          "links": [],
          "title": "Programs",
          "vizConfig": {
            "group": "marcusolsson-dynamictext-panel",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "afterRender": "const box = context.element.querySelector('.vacuum');\nconst theme = context.grafana.theme;\nconst rows = context.data || [];\n\nconst send = async (path, done) => {\n  const response = await fetch('/api/ds/query', {\n    method: 'POST',\n    headers: { 'Content-Type': 'application/json' },\n    body: JSON.stringify({\n      from: 'now-5m',\n      to: 'now',\n      queries: [{\n        refId: 'A',\n        datasource: { uid: 'roborock' },\n        type: 'json',\n        source: 'url',\n        parser: 'backend',\n        format: 'table',\n        url: '@@ROBOROCK_URL@@' + path,\n        url_options: { method: 'POST', data: '' },\n      }],\n    }),\n  });\n  const body = await response.json().catch(() => ({}));\n  const error = body.results && body.results.A && body.results.A.error;\n  if (!response.ok || error) {\n    context.grafana.notifyError(['Vacuum', error || body.message || response.statusText]);\n    return;\n  }\n  context.grafana.notifySuccess(['Vacuum', done]);\n  context.grafana.refresh();\n};\n\nconst button = (label, color, path, done) => {\n  const b = document.createElement('button');\n  b.textContent = label;\n  b.style.background = color.main;\n  b.style.color = color.contrastText;\n  b.addEventListener('click', async () => {\n    b.disabled = true;\n    try { await send(path, done); } finally { b.disabled = false; }\n  });\n  return b;\n};\n\nconst programs = document.createElement('div');\nprograms.className = 'programs';\nrows.forEach((row) => programs.append(\n  button(row.name, theme.colors.primary, '/routines/' + row.id, row.name + ' started')));\nconst controls = document.createElement('div');\ncontrols.className = 'controls';\ncontrols.append(\n  button('Stop', theme.colors.error, '/stop', 'Stopped'),\n  button('Return to dock', theme.colors.secondary, '/dock', 'Returning to the dock'));\nbox.replaceChildren(programs, controls);\n",
                "content": "<div class=\"vacuum\"></div>",
                "contentPartials": [],
                "defaultContent": "The vacuum controller returned no routines.",
                "editor": {
                  "format": "auto",
                  "height": 200,
                  "language": "html"
                },
                "editors": [
                  "afterRender",
                  "styles"
                ],
                "externalScripts": [],
                "externalStyles": [],
                "helpers": "",
                "renderMode": "allRows",
                "styles": "& .vacuum {\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n& .programs, & .controls {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n& button {\n  border: 0;\n  border-radius: 4px;\n  padding: 10px 16px;\n  font-size: 15px;\n  cursor: pointer;\n}\n\n& button:disabled {\n  opacity: 0.5;\n  cursor: wait;\n}\n",
                "wrap": false
              }
            },
            "version": "6.3.0"
          }
        }
      },
