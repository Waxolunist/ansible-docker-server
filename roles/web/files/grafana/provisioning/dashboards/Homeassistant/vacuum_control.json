                        },
                        "updating": {
                          "color": "orange",
                          "index": 14,
                          "text": "Updating"
                        },
                        "washing_the_mop": {
                          "color": "purple",
                          "index": 7,
                          "text": "Washing the mop"
                        },
                        "washing_the_mop_2": {
