                      {
                        "id": "custom.fillOpacity",
                        "value": 80
                      },
                      {
                        "id": "custom.lineWidth",
                        "value": 1
                      },
                      {
                        "id": "custom.showPoints",
                        "value": "never"
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Combustion car"
                    },
                    "properties": [
                      {
                        "id": "displayName",
                        "value": "Combustion car"
                      },
                      {
                        "id": "color",
                        "value": {
