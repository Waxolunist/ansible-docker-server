      "panel-13": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select time as \"Time\", round(grid_kw::numeric, 1) as \"Grid kW\", round(house_kw::numeric, 1) as \"House kW\", round(goe_kw::numeric, 1) as \"Charger kW\",\n  round(limit_kw::numeric, 1) as \"Limit kW\", round(room_kw::numeric, 1) as \"Room kW\", phases || ' x ' || ampere || ' A' as \"Step\", round(step_kw::numeric, 1) as \"Step kW\"\nfrom data_charging_decision\nwhere $__timeFilter(time) and changed\norder by time desc\nlimit 200;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
