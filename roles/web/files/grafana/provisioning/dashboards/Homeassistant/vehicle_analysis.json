                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Every minute the auto mode changed the charger's step: the readings it used and the step it chose. Room = limit - (grid import - charger power).",
          "id": 13,
          "links": [],
          "title": "Auto charging: step changes",
