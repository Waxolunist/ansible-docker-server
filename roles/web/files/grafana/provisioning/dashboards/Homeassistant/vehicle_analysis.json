                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select time, grid_kw as \"Grid import\", limit_kw as \"Limit\", goe_kw as \"Charger power\", step_kw as \"Chosen step\"\nfrom data_charging_decision\nwhere $__timeFilter(time)\norder by time;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
