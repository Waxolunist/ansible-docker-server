                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "One point per minute while a car is connected and the charging mode is auto. Grid import stays under the limit by lowering the charger's step; the step is raised again only after five minutes of room.",
          "id": 12,
          "links": [],
          "title": "Auto charging: grid import against the limit",
