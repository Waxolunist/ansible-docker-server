                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- Self consumption and the share are null where there is no production data (solar gap, TASK-107).\nwith base as (\n  select make_timestamptz(year::int, month::int, 1, 0, 0, 0, 'Europe/Vienna') as time,\n    case when energy_produced is not null then energy_self_consumption end as energy_self_consumption,\n    energy_feeded\n  from agg_1month_energy_values_with_pricing\n)\nselect time, energy_self_consumption, energy_feeded,\n  energy_self_consumption + energy_feeded as \"Total\",\n  energy_self_consumption / nullif(energy_self_consumption + energy_feeded, 0) as selfusage_percentage\nfrom base\nwhere $__timeFilter(time)\norder by time\n",
