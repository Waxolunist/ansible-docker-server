      "panel-5": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- One row per month, stamped at local midnight on the 1st. Smart meter rows are stamped at the end of their quarter.\nwith mp as (\n  select id, timezone from master_smartmeter_metering_point where feeding = false\n), sm as (\n  select e.time - interval '15 minutes' as quarter, e.energy * 4 as kw\n  from data_smartmeter_energy e\n  join mp on mp.id = e.metering_point_id\n), live as (\n  select time_bucket('15 minutes', time) as quarter, avg(greatest(grid_kw, 0)) as kw\n  from data_power_live\n  where time >= (select max(e.time) from data_smartmeter_energy e join mp on mp.id = e.metering_point_id)\n    and time < time_bucket('15 minutes', now())\n  group by 1\n), q as (\n  select * from sm\n  union all\n  select * from live\n)\nselect date_trunc('month', quarter, (select timezone from mp)) as time,\n  max(kw) as \"Max grid import\"\nfrom q\ngroup by 1\norder by 1\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "hideTimeOverride": true,
                "timeFrom": "18M",
                "timeShift": "1y/M+15M"
              },
              "transformations": []
            }
          },
          "description": "Highest grid import per month as a 15-minute average over the clock quarters, the value the grid operator's smart meter records (data_smartmeter_energy, consuming metering point: kWh per quarter × 4 = kW). Quarters the meter has not delivered yet (it arrives the next day) come from data_power_live as the average import of the quarter, finished quarters only. Months are local (Europe/Vienna).",
          "id": 5,
          "links": [],
          "title": "Max grid import (15 min)",
