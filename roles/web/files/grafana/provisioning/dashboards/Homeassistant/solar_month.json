                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "-- One row per month, stamped at local midnight on the 1st (year/month are local).\n-- Self consumption is null where there is no production data (solar gap, TASK-107).\nselect make_timestamptz(agg.year::int, agg.month::int, 1, 0, 0, 0, msmp.timezone) as time,\n  agg.energy as \"Grid consumption\",\n  ev.energy_self_consumption as \"Self consumption\",\n  agg.energy + ev.energy_self_consumption as \"Total consumption\"\nfrom agg_1month_stats_data_smartmeter_energy_with_pricing agg\njoin master_smartmeter_metering_point msmp on msmp.id = agg.metering_point_id\nleft join agg_1month_energy_values_with_pricing ev\n  on ev.name = msmp.name and ev.year = agg.year and ev.month = agg.month\n  and ev.energy_produced is not null\nwhere msmp.feeding = false\norder by 1\n",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
                          ],
                          "groupBy": [
                            {
                              "property": {
                                "type": "string"
                              },
                              "type": "groupBy"
                            }
                          ],
                          "limit": 50
                        }
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "hideTimeOverride": true,
                "timeFrom": "18M",
                "timeShift": "1y/M+15M"
              },
              "transformations": [
                {
                  "group": "regression",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "degree": 5,
                      "modelType": "polynomial",
                      "predictionCount": 100,
                      "xFieldName": "time",
                      "yFieldName": "Grid consumption"
