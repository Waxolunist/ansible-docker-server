                        "rawQuery": true,
                        "rawSql": "with base as (\n  select time,\n    case when energy_inverter > 0 then energy_self_consumption end as energy_self_consumption,\n    energy_feeded\n  from agg_1month_energy_priced\n  where metered_hours > 0\n)\nselect time, energy_self_consumption, energy_feeded,\n  energy_self_consumption + energy_feeded as \"Total\",\n  energy_self_consumption / nullif(energy_self_consumption + energy_feeded, 0) as selfusage_percentage\nfrom base\nwhere $__timeFilter(time)\norder by time;",
