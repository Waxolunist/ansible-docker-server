{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "home"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "editable": true,
    "elements": {
      "panel-90": "@@ENERGY_FLOW_PANEL@@"
    },
    "liveNow": false,
    "preload": false,
    "links": [],
    "tags": [],
    "title": "Home",
    "variables": [],
    "timeSettings": {
      "autoRefresh": "10s",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-6h",
      "hideTimepicker": true,
      "timezone": "browser",
      "to": "now"
    },
    "layout": {
      "kind": "RowsLayout",
      "spec": {
        "rows": [
          {
            "kind": "RowsLayoutRow",
            "spec": {
              "collapse": false,
              "fillScreen": true,
              "hideHeader": true,
              "title": "Energy flow",
              "layout": {
                "kind": "AutoGridLayout",
                "spec": {
                  "columnWidthMode": "standard",
                  "fillScreen": true,
                  "maxColumnCount": 1,
                  "rowHeightMode": "standard",
                  "items": [
                    {
                      "kind": "AutoGridLayoutItem",
                      "spec": {
                        "element": {
                          "kind": "ElementReference",
                          "name": "panel-90"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
  }
}
