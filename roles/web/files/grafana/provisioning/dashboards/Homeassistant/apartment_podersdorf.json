    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select distinct on (device_id)\n       name as \"Radiator\", temperature as \"Room\", setpoint as \"Setpoint\",\n       local_mode as \"Mode\", use_mode as \"Program\", heat_authorization as \"Heating\",\n       opening_detected as \"Window open\", defect as \"Defect\", time as \"Read at\"\nfrom data_heating\nwhere site = 'podersdorf'\norder by device_id, time desc;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "data_heating: the newest reading of each Podersdorf radiator from the Tydom gateway (TydomJob, every 5 minutes, through the Delta Dore cloud). Mode: NORMAL, STOP, ANTI_FROST, ABSENCE. Program: SCHED (weekly schedule), OVERRIDE (temporary), MANUAL.",
          "id": 1,
          "links": [],
          "title": "Radiators now",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Room"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Setpoint"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Read at"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeFromNow"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "select $__timeGroupAlias(time, $__interval), name || ' room' as metric, avg(temperature) as value\nfrom data_heating\nwhere site = 'podersdorf' and $__timeFilter(time)\ngroup by 1, 2\nunion all\nselect $__timeGroupAlias(time, $__interval), name || ' setpoint', avg(setpoint)\nfrom data_heating\nwhere site = 'podersdorf' and $__timeFilter(time)\ngroup by 1, 2\norder by 1;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "interval": "5m"
              },
              "transformations": []
            }
          },
          "description": "Room temperature (solid) and setpoint (dashed) per radiator, averaged over the bucket Grafana picks for the range. Readings start on 2026-11-14.",
          "id": 2,
          "links": [],
          "title": "Room temperature and setpoint",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
