{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "apartment-podersdorf"
  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Tooltip",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "select distinct on (device_id)\n       name as \"Radiator\", temperature as \"Room\", setpoint as \"Setpoint\",\n       local_mode as \"Mode\", use_mode as \"Program\", heat_authorization as \"Heating\",\n       opening_detected as \"Window open\", defect as \"Defect\", time as \"Read at\"\nfrom data_heating\nwhere site = 'podersdorf'\norder by device_id, time desc;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "data_heating: the newest reading of each Podersdorf radiator from the Tydom gateway (TydomJob, every 5 minutes, through the Delta Dore cloud). Mode: NORMAL, STOP, ANTI_FROST, ABSENCE. Program: SCHED (weekly schedule), OVERRIDE (temporary), MANUAL.",
          "id": 1,
          "links": [],
          "title": "Radiators now",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    }
                  }
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Room"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Setpoint"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "decimals",
                        "value": 1
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Read at"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "dateTimeFromNow"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "select $__timeGroupAlias(time, $__interval), name || ' room' as metric, avg(temperature) as value\nfrom data_heating\nwhere site = 'podersdorf' and $__timeFilter(time)\ngroup by 1, 2\nunion all\nselect $__timeGroupAlias(time, $__interval), name || ' setpoint', avg(setpoint)\nfrom data_heating\nwhere site = 'podersdorf' and $__timeFilter(time)\ngroup by 1, 2\norder by 1;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "interval": "5m"
              },
              "transformations": []
            }
          },
          "description": "Room temperature (solid) and setpoint (dashed) per radiator, averaged over the bucket Grafana picks for the range. Readings start on 2026-11-14.",
          "id": 2,
          "links": [],
          "title": "Room temperature and setpoint",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "barAlignment": 1,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "decimals": 1,
                  "unit": "celsius"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byRegexp",
                      "options": ".* setpoint"
                    },
                    "properties": [
                      {
                        "id": "custom.lineInterpolation",
                        "value": "stepAfter"
                      },
                      {
                        "id": "custom.lineStyle",
                        "value": {
                          "dash": [
                            10,
                            10
                          ],
                          "fill": "dash"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              }
            },
            "version": "13.2.4"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "select $__timeGroupAlias(e.time - interval '15 minutes', '1h'), sum(e.energy) as \"Consumption\"\nfrom data_smartmeter_energy e\njoin master_smartmeter_metering_point m on m.id = e.metering_point_id\nwhere m.site = 'podersdorf'\n  and $__timeFilter(e.time)\ngroup by 1\norder by 1;"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                },
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "c17a467f-0417-4c81-b598-1bf916d7bba7"
                      },
                      "group": "grafana-postgresql-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "format": "time_series",
                        "rawQuery": true,
                        "rawSql": "select $__timeGroupAlias(time, '1h'), avg(temperature) as \"Room temperature\", avg(setpoint) as \"Setpoint\"\nfrom data_heating\nwhere site = 'podersdorf' and $__timeFilter(time)\ngroup by 1\norder by 1;"
                      },
                      "version": "v0"
                    },
                    "refId": "B"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "How the heating relates to the electricity use: hourly consumption of both Podersdorf meters together (bars, left axis; the radiators, the infrared panel and everything else) against the hourly mean room temperature and setpoint of the radiators (lines, right axis). The meter data is a day behind, the heating data is live. No estimate of the radiators' own energy: the gateway reports no power, so it can't be separated reliably.",
          "id": 3,
          "links": [],
          "title": "Heating and consumption",
          "vizConfig": {
            "group": "timeseries",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
                    "mode": "palette-classic"
                  },
                  "custom": {
                    "axisPlacement": "auto",
                    "barAlignment": 1,
                    "drawStyle": "line",
                    "fillOpacity": 0,
                    "lineInterpolation": "linear",
                    "lineWidth": 2,
                    "showPoints": "never",
                    "spanNulls": false,
                    "stacking": {
                      "group": "A",
                      "mode": "none"
                    }
                  },
                  "decimals": 1
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Consumption"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "kwatth"
                      },
                      {
                        "id": "min",
                        "value": 0
                      },
                      {
                        "id": "custom.drawStyle",
                        "value": "bars"
                      },
                      {
                        "id": "custom.fillOpacity",
                        "value": 60
                      },
                      {
                        "id": "custom.lineWidth",
                        "value": 1
                      },
                      {
                        "id": "custom.axisPlacement",
                        "value": "left"
                      },
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "orange",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Room temperature"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "custom.axisPlacement",
                        "value": "right"
                      },
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "red",
                          "mode": "fixed"
                        }
                      }
                    ]
                  },
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "Setpoint"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "celsius"
                      },
                      {
                        "id": "custom.axisPlacement",
                        "value": "right"
                      },
                      {
                        "id": "custom.lineInterpolation",
                        "value": "stepAfter"
                      },
                      {
                        "id": "custom.lineStyle",
                        "value": {
                          "dash": [
                            10,
                            10
                          ],
                          "fill": "dash"
                        }
                      },
                      {
                        "id": "color",
                        "value": {
                          "fixedColor": "blue",
                          "mode": "fixed"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "legend": {
                  "calcs": [],
                  "displayMode": "list",
                  "placement": "bottom",
                  "showLegend": true
                },
                "tooltip": {
                  "mode": "multi",
                  "sort": "none"
                }
              }
            },
            "version": "13.2.4"
          }
        }
      }
    },
    "layout": {
      "kind": "TabsLayout",
      "spec": {
        "tabs": [
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "collapse": false,
                        "hideHeader": true,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "standard",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-1"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 1,
                            "rowHeight": 160,
                            "rowHeightMode": "custom"
                          }
                        },
                        "title": "Radiators"
                      }
                    }
                  ]
                }
              },
              "title": "Control"
            }
          },
          {
            "kind": "TabsLayoutTab",
            "spec": {
              "layout": {
                "kind": "RowsLayout",
                "spec": {
                  "rows": [
                    {
                      "kind": "RowsLayoutRow",
                      "spec": {
                        "collapse": false,
                        "hideHeader": true,
                        "layout": {
                          "kind": "AutoGridLayout",
                          "spec": {
                            "columnWidthMode": "standard",
                            "fillScreen": false,
                            "items": [
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-3"
                                  }
                                }
                              },
                              {
                                "kind": "AutoGridLayoutItem",
                                "spec": {
                                  "element": {
                                    "kind": "ElementReference",
                                    "name": "panel-2"
                                  }
                                }
                              }
                            ],
                            "maxColumnCount": 1,
                            "rowHeightMode": "tall"
                          }
                        },
                        "title": "Heating"
                      }
                    }
                  ]
                }
              },
              "title": "Analysis"
            }
          }
        ]
      }
    },
    "links": [
      {
        "asDropdown": false,
        "icon": "dashboard",
        "includeVars": false,
        "keepTime": false,
        "tags": [],
        "targetBlank": false,
        "title": "Home",
        "tooltip": "",
        "type": "link",
        "url": "/d/home-podersdorf"
      },
      {
        "asDropdown": true,
        "icon": "external link",
        "includeVars": false,
        "keepTime": true,
        "tags": [
          "podersdorf"
        ],
        "targetBlank": false,
        "title": "Homeassistant",
        "tooltip": "",
        "type": "dashboards",
        "url": ""
      }
    ],
    "liveNow": false,
    "preload": false,
    "tags": [
      "podersdorf"
    ],
    "timeSettings": {
      "autoRefresh": "",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "fiscalYearStartMonth": 0,
      "from": "now-7d",
      "hideTimepicker": false,
      "quickRanges": "@@QUICK_RANGES@@",
      "timezone": "browser",
      "to": "now"
    },
    "title": "Apartment - Podersdorf",
    "variables": []
  }
}
