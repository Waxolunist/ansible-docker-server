services:
  registry:
    image: registry:3.0.0
    container_name: web_registry
    mem_limit: 256M
    cpus: 0.5
    depends_on:
      - reverse-proxy
    expose:
      - {{ registry.port }}
    volumes:
      - "{{ docker.paths.work }}registry:/var/lib/registry"
      - "{{ docker.paths.configs }}registry/config.yml:/etc/distribution/config.yml:ro"
      - "{{ docker.paths.logs }}registry:/var/log/docker-registry"
      - "{{ docker.paths.configs }}registry/secrets:/secrets:ro"
    networks:
      - monitoring_ui
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_monitoring_ui
      - traefik.http.middlewares.registry-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.registry-secure.entrypoints=websecure
      - traefik.http.routers.registry-secure.rule=Host(`{{ registry.domain }}`)
      - traefik.http.routers.registry-secure.tls=true
      - traefik.http.routers.registry-secure.tls.certresolver=myresolver
      - traefik.http.routers.registry-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.registry.entrypoints=web
      - traefik.http.routers.registry.middlewares=registry-https-redirect
      - traefik.http.routers.registry.rule=Host(`{{ registry.domain }}`)
    environment:
      - TZ=Europe/Vienna
      - OTEL_TRACES_EXPORTER=none
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:{{ registry.port }}/v2/"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  autoheal:
    image: willfarrell/autoheal:latest@sha256:7ab2ddc7ec5f5933fd5d92df8d0feb928b185fc50d62a3e215d1c40fb21ab9c9
    container_name: web_autoheal
    mem_limit: 64M
    cpus: 0.1
    restart: always
    environment:
      - AUTOHEAL_CONTAINER_LABEL=autoheal
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock"

  socket-proxy:
    image: tecnativa/docker-socket-proxy:v0.4.2
    container_name: web_socket-proxy
    environment:
      - CONTAINERS=1
      - NETWORKS=1
      - EVENTS=1
      - POST=0
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
    networks:
      - socket_proxy
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:2375/version || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    labels:
      - autoheal=true
    restart: unless-stopped

  reverse-proxy:
    image: traefik:v3.6.13
    container_name: web_reverse-proxy
    depends_on:
      - socket-proxy
    ports:
      - "80:80"
      - "443:443"
    expose:
      - 8080
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 512M
    cpus: 1.0
    volumes:
      - "{{ docker.paths.configs }}traefik:/etc/traefik:ro"
      - "{{ docker.paths.work }}traefik:/var/run/traefik"
      - "{{ docker.paths.logs }}traefik/:/var/log/traefik"
    environment:
      - TZ=Europe/Vienna
    networks:
      proxy:
      socket_proxy:
      wiki:
      grafana_ui:
        ipv4_address: {{ traefik.grafana_ui_address }}
      monitoring_ui:
      code_ui:
      picoclaw_ui:
    labels:
      - autoheal=true
      - traefik.enable=true
      # --- Global security headers middleware ---
      - traefik.http.middlewares.security-headers.headers.stsSeconds=63072000
      - traefik.http.middlewares.security-headers.headers.stsIncludeSubdomains=true
      - traefik.http.middlewares.security-headers.headers.stsPreload=true
      - traefik.http.middlewares.security-headers.headers.forceSTSHeader=true
      - traefik.http.middlewares.security-headers.headers.customFrameOptionsValue=SAMEORIGIN
      - traefik.http.middlewares.security-headers.headers.contentTypeNosniff=true
      - traefik.http.middlewares.security-headers.headers.referrerPolicy=strict-origin-when-cross-origin
      - traefik.http.middlewares.security-headers.headers.permissionsPolicy=camera=(), microphone=(), geolocation=(), payment=()
      - traefik.http.middlewares.security-headers.headers.customResponseHeaders.X-XSS-Protection=0
      # --- Global rate limiting middleware ---
      - traefik.http.middlewares.rate-limit.ratelimit.average=100
      - traefik.http.middlewares.rate-limit.ratelimit.burst=200
      - traefik.http.middlewares.rate-limit.ratelimit.period=1m
      # --- Traefik dashboard routes ---
      - traefik.http.middlewares.proxy-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.proxy-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.proxy-secure.entrypoints=websecure
      - traefik.http.routers.proxy-secure.rule=Host(`{{ traefik.domain }}`)
      - traefik.http.routers.proxy-secure.tls=true
      - traefik.http.routers.proxy-secure.tls.certresolver=myresolver
      - traefik.http.routers.proxy-secure.service=api@internal
      - traefik.http.routers.proxy.entrypoints=web
      - traefik.http.routers.proxy.middlewares=proxy-https-redirect
      - traefik.http.routers.proxy.rule=Host(`{{ traefik.domain }}`)
      # --- me-page redirect routes ---
      - traefik.http.routers.mepage.rule=Host(`{{ redirect.domains | join('`) || Host(`') }}`)
      - traefik.http.routers.mepage.entrypoints=web
      - traefik.http.routers.mepage.middlewares=proxy-https-redirect
      - traefik.http.routers.mepage-secure.middlewares=me-redirectregex,security-headers@docker
      - traefik.http.routers.mepage-secure.entrypoints=websecure
      - traefik.http.routers.mepage-secure.rule=Host(`{{ redirect.domains | join('`) || Host(`') }}`)
      - traefik.http.routers.mepage-secure.tls=true
      - traefik.http.routers.mepage-secure.tls.certresolver=myresolver
      - traefik.http.routers.mepage-secure.service=noop@internal
      - traefik.http.middlewares.me-redirectregex.redirectregex.regex=^https://({{ redirect.domains | join('|') }})(/.*)?
      - traefik.http.middlewares.me-redirectregex.redirectregex.replacement={{ redirect.target }}
      - traefik.http.routers.apex.rule=Host(`{{ topleveldomain }}`)
      - traefik.http.routers.apex.entrypoints=web
      - traefik.http.routers.apex.middlewares=proxy-https-redirect
      - traefik.http.routers.apex-secure.middlewares=apex-redirectregex,security-headers@docker
      - traefik.http.routers.apex-secure.entrypoints=websecure
      - traefik.http.routers.apex-secure.rule=Host(`{{ topleveldomain }}`)
      - traefik.http.routers.apex-secure.tls=true
      - traefik.http.routers.apex-secure.tls.certresolver=myresolver
      - traefik.http.routers.apex-secure.service=noop@internal
      - traefik.http.middlewares.apex-redirectregex.redirectregex.regex=^https://{{ topleveldomain | regex_escape }}(/.*)?
      - traefik.http.middlewares.apex-redirectregex.redirectregex.replacement={{ redirect.apex_target }}
    healthcheck:
      test: ["CMD", "traefik", "healthcheck", "--ping"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  prometheus:
    image: prom/prometheus:v3.11.1
    container_name: web_prometheus
    read_only: true
    tmpfs:
      - /tmp
    mem_limit: 2G
    cpus: 1.0
    expose:
      - 9090
    depends_on:
      - reverse-proxy
    volumes:
      - "{{ docker.paths.configs }}prometheus:/etc/prometheus:ro"
      - "{{ docker.paths.data }}prometheus:/prometheus"
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time=100d'
    environment:
      - TZ=Europe/Vienna
    networks:
      - monitoring_ui
      - prometheus
    extra_hosts:
      docker.host: {{ docker_ip_address }}
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_monitoring_ui
      - traefik.http.middlewares.metrics-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.metrics-secure.entrypoints=websecure
      - traefik.http.routers.metrics-secure.rule=Host(`{{ prometheus.domain }}`)
      - traefik.http.routers.metrics-secure.tls=true
      - traefik.http.routers.metrics-secure.tls.certresolver=myresolver
      - traefik.http.routers.metrics-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.metrics.entrypoints=web
      - traefik.http.routers.metrics.middlewares=metrics-https-redirect
      - traefik.http.routers.metrics.rule=Host(`{{ prometheus.domain }}`)
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:9090/-/healthy || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: unless-stopped

  node-exporter:
    image: prom/node-exporter:v1.11.1
    container_name: web_node-exporter
    mem_limit: 128M
    cpus: 0.25
    read_only: true
    environment:
      - TZ=Europe/Vienna
    expose:
      - 9100
    command:
      - '--path.rootfs=/host'
      - '--collector.textfile.directory=/textfile_collector'
    volumes:
      - "{{ docker.paths.data }}node-exporter:/textfile_collector:ro"
      - "/:/host:ro,rslave"
    labels:
      - autoheal=true
      - traefik.enable=false
    depends_on:
      - prometheus
    networks:
      - prometheus
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:9100/ || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  cadvisor:
    image: gcr.io/cadvisor/cadvisor:v0.55.1
    container_name: web_cadvisor
    cap_add:
      - SYS_PTRACE
      - DAC_READ_SEARCH
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp
    command:
      - --docker_only=true
      - --housekeeping_interval=30s
      - --store_container_labels=false
      - --disable_metrics=percpu,sched,tcp,udp,advtcp,hugetlb,referenced_memory,cpu_topology,resctrl,process,disk,diskIO
    mem_limit: 512M
    cpus: 0.5
    devices:
      - /dev/kmsg
    group_add:
      - "{{ docker_gid }}"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:rw
      - /sys:/sys:ro
      - /sys/fs/cgroup:/sys/fs/cgroup:ro
    expose:
      - 8080
    networks:
      - monitoring_ui
      - prometheus
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_monitoring_ui
      - traefik.http.middlewares.cadvisor-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.cadvisor-secure.entrypoints=websecure
      - traefik.http.routers.cadvisor-secure.rule=Host(`{{ cadvisor.domain }}`)
      - traefik.http.routers.cadvisor-secure.tls=true
      - traefik.http.routers.cadvisor-secure.tls.certresolver=myresolver
      - traefik.http.routers.cadvisor-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.cadvisor.entrypoints=web
      - traefik.http.routers.cadvisor.middlewares=cadvisor-https-redirect
      - traefik.http.routers.cadvisor.rule=Host(`{{ cadvisor.domain }}`)
    depends_on:
      - prometheus
    restart: unless-stopped

  alertmanager:
    image: prom/alertmanager:v0.34.1
    container_name: web_alertmanager
    read_only: true
    mem_limit: 128M
    cpus: 0.25
    depends_on:
      - reverse-proxy
    expose:
      - {{ alertmanager.port }}
    ports:
      - "{{ wireguard.address }}:{{ alertmanager.port }}:{{ alertmanager.port }}"
    volumes:
      - "{{ docker.paths.configs }}alertmanager:/etc/alertmanager:ro"
      - "{{ docker.paths.data }}alertmanager:/alertmanager"
    command:
      - '--config.file=/etc/alertmanager/alertmanager.yml'
      - '--storage.path=/alertmanager'
      - '--web.external-url=https://{{ alertmanager.domain }}'
      - '--cluster.listen-address='
    secrets:
      - matrix_receiver_password
    environment:
      - TZ=Europe/Vienna
    networks:
      - monitoring_ui
      - prometheus
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_monitoring_ui
      - traefik.http.middlewares.alerts-https-redirect.redirectscheme.scheme=https
      - traefik.http.services.alerts.loadbalancer.server.port={{ alertmanager.port }}
      - traefik.http.routers.alerts-secure.entrypoints=websecure
      - traefik.http.routers.alerts-secure.rule=Host(`{{ alertmanager.domain }}`)
      - traefik.http.routers.alerts-secure.service=alerts
      - traefik.http.routers.alerts-secure.tls=true
      - traefik.http.routers.alerts-secure.tls.certresolver=myresolver
      - traefik.http.routers.alerts-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.alerts.entrypoints=web
      - traefik.http.routers.alerts.middlewares=alerts-https-redirect
      - traefik.http.routers.alerts.rule=Host(`{{ alertmanager.domain }}`)
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:{{ alertmanager.port }}/-/healthy || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  matrix-receiver:
    image: metio/matrix-alertmanager-receiver:2026.9.23
    container_name: web_matrix-receiver
    read_only: true
    mem_limit: 64M
    cpus: 0.25
    depends_on:
      - conduit
    expose:
      - {{ matrix_receiver.port }}
    ports:
      - "{{ wireguard.address }}:{{ matrix_receiver.port }}:{{ matrix_receiver.port }}"
    volumes:
      - "{{ docker.paths.configs }}matrix_receiver/config.yml:/etc/matrix-receiver/config.yml:ro"
    command:
      - '--config-path=/etc/matrix-receiver/config.yml'
    environment:
      - TZ=Europe/Vienna
    networks:
      - proxy
      - prometheus
    labels:
      - traefik.enable=false
    restart: unless-stopped

  authelia:
    image: {{ authelia.image }}
    container_name: authelia
    volumes:
      - "{{ docker.paths.configs }}authelia:/config:ro"
      - "{{ docker.paths.data }}authelia/db.sqlite3:/var/db.sqlite3"
      # Writable: password resets and scripts/authelia_user.sh change the
      # users database. A directory, not the file, so the watcher keeps
      # working when the file is replaced.
      - "{{ docker.paths.data }}authelia/users:/users"
      - "{{ docker.paths.logs }}authelia:/var/log/authelia"
    secrets:
      - authelia_jwt_secret
      - authelia_session_secret
      - authelia_storage_encryption_key
      - smtp_password
    environment:
      - AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE=/run/secrets/authelia_jwt_secret
      - AUTHELIA_SESSION_SECRET_FILE=/run/secrets/authelia_session_secret
      - AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=/run/secrets/authelia_storage_encryption_key
      - AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE=/run/secrets/smtp_password
      - TZ=Europe/Vienna
    depends_on:
      - reverse-proxy
    networks:
      - proxy
      - prometheus
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_proxy
      - traefik.http.middlewares.auth-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.auth-secure.entrypoints=websecure
      - traefik.http.routers.auth-secure.rule=Host(`{{ authelia.domain }}`)
      - traefik.http.routers.auth-secure.middlewares=security-headers@docker,rate-limit@docker
      - traefik.http.routers.auth-secure.tls=true
      - traefik.http.routers.auth-secure.tls.certresolver=myresolver
      - traefik.http.routers.auth.entrypoints=web
      - traefik.http.routers.auth.middlewares=auth-https-redirect
      - traefik.http.routers.auth.rule=Host(`{{ authelia.domain }}`)
      # The login portal URL comes from session.cookies[].authelia_url.
      - traefik.http.middlewares.auth.forwardauth.address=http://authelia:{{ authelia.port }}/api/authz/forward-auth
      - traefik.http.middlewares.auth.forwardauth.trustForwardHeader=true
      - traefik.http.middlewares.auth.forwardauth.maxResponseBodySize=8192
      - traefik.http.middlewares.auth.forwardauth.authResponseHeaders=Remote-User,Remote-Groups,Remote-Email,Remote-Name
    expose:
      - {{ authelia.port }}
    mem_limit: 256M
    cpus: 0.5
    restart: unless-stopped

  grafana-pg:
    image: postgres:18-alpine
    container_name: grafana-pg
    user: "70:70"
    mem_limit: 256M
    cpus: 0.5
    networks:
      - grafana
    expose:
      - 5432
    secrets:
      - grafana_pg_password
    environment:
      - POSTGRES_PASSWORD_FILE=/run/secrets/grafana_pg_password
      - POSTGRES_USER={{ vault_grafana_pg_user }}
      - POSTGRES_DB=grafana
      - TZ=Europe/Vienna
    volumes:
      # From 18 on, the image keeps the cluster in /var/lib/postgresql/<major>/docker
      # and refuses an older one mounted at .../data. pgdata/ holds the
      # PostgreSQL 13 cluster from before the upgrade.
      - "{{ docker.paths.data }}grafana/postgres:/var/lib/postgresql"
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ vault_grafana_pg_user }} -d grafana"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  grafana:
    image: grafana/grafana:13.2.4
    container_name: web_grafana
    mem_limit: 1G
    cpus: 1.0
    volumes:
      - "{{ docker.paths.configs }}grafana:/etc/grafana:ro"
      - "{{ docker.paths.data }}grafana:/var/lib/grafana"
      - "{{ docker.paths.logs }}grafana:/var/log/grafana"
    expose:
      - 3000
    depends_on:
      grafana-pg:
        condition: service_healthy
      prometheus:
        condition: service_started
    secrets:
      - grafana_pg_password
      - smtp_password
    environment:
      - TZ=Europe/Vienna
      - GF_SMTP_USER={{ vault_smtp_server_user }}
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_grafana_ui
      - traefik.http.middlewares.grafana-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.grafana-secure.entrypoints=websecure
      - traefik.http.routers.grafana-secure.rule=Host(`{{ grafana.domain }}`)
      - traefik.http.routers.grafana-secure.tls=true
      - traefik.http.routers.grafana-secure.tls.certresolver=myresolver
      - traefik.http.routers.grafana-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.grafana.entrypoints=web
      - traefik.http.routers.grafana.middlewares=grafana-https-redirect
      - traefik.http.routers.grafana.rule=Host(`{{ grafana.domain }}`)
    networks:
      - grafana_ui
      - grafana
      - prometheus
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:3000/api/health || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      # Version upgrades migrate the database before the HTTP server starts;
      # autoheal must not restart Grafana in the middle of that.
      start_period: 120s
    restart: unless-stopped

  minecraft:
    image: itzg/minecraft-server:2026.4.1
    container_name: minecraft
    environment:
      - EULA=TRUE
      - TZ=Europe/Vienna
      - ENABLE_ROLLING_LOGS=true
      - INIT_MEMORY=1G
      - MAX_MEMORY=2G
    mem_limit: "2048M"
    ports:
      - {{ minecraft.port }}:{{ minecraft.port }}
    expose:
      - {{ minecraft.port }}
    volumes:
      - "{{ docker.paths.data }}minecraft:/data"
    labels:
      - autoheal=true
    healthcheck:
      test: mc-health
      start_period: 1m
      interval: 5s
      retries: 20
    restart: unless-stopped

  coturn:
    image: coturn/coturn:4.6
    container_name: web_coturn
    mem_limit: 256M
    cpus: 0.5
    # Host networking is the sane choice for coturn: the relay port range would
    # otherwise need publishing port-by-port, and coturn sees the real client
    # address rather than Docker's bridge address. It also means this container
    # is not on the proxy network and carries no Traefik labels -- STUN/TURN is
    # not HTTP, so there is nothing for the reverse proxy to route.
    network_mode: host
    volumes:
      - "{{ docker.paths.configs }}coturn/turnserver.conf:/etc/coturn/turnserver.conf:ro"
{% if coturn.tls %}
      - "{{ docker.paths.configs }}coturn/certs:/etc/coturn/certs:ro"
{% endif %}
    # Log to stdout so the entries land in the docker json log, which
    # logrotate already covers -- no extra bind mount and no uid juggling.
    command: ["-c", "/etc/coturn/turnserver.conf", "--log-file=stdout"]
    environment:
      - TZ=Europe/Vienna
    labels:
      - autoheal=true
    healthcheck:
      # A plain STUN binding request against the listener -- no credentials, no
      # relay allocation. It must target the address coturn actually binds:
      # with listening-ip set, coturn is not on 127.0.0.1 and probing loopback
      # would hang until the timeout and trip autoheal.
      test: ["CMD-SHELL", "turnutils_stunclient -p {{ coturn.port }} {{ coturn.listening_ip | default('127.0.0.1', true) }} >/dev/null 2>&1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 20s
    restart: unless-stopped

  # Pairs two phones for Hulls & Hellfire: the host leaves a WebRTC offer under
  # a six-character code, the joiner takes it and leaves the answer. Two blobs,
  # once each, then the session is dropped -- no game traffic passes here.
  rendezvous:
    image: node:22-alpine
    container_name: web_rendezvous
    mem_limit: 128M
    cpus: 0.5
    depends_on:
      - reverse-proxy
    user: node
    read_only: true
    tmpfs:
      - /tmp
    expose:
      - {{ rendezvous.port }}
    volumes:
      - "{{ docker.paths.configs }}rendezvous/server.js:/app/server.js:ro"
    working_dir: /app
    command: ["node", "server.js"]
    environment:
      - TZ=Europe/Vienna
      - PORT={{ rendezvous.port }}
      - SESSION_TTL_MS={{ rendezvous.session_ttl_ms }}
    networks:
      - proxy
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.http.middlewares.rendezvous-https-redirect.redirectscheme.scheme=https
      - traefik.http.services.rendezvous.loadbalancer.server.port={{ rendezvous.port }}
      - traefik.http.routers.rendezvous-secure.entrypoints=websecure
      - traefik.http.routers.rendezvous-secure.rule=Host(`{{ rendezvous.domain }}`)
      - traefik.http.routers.rendezvous-secure.service=rendezvous
      - traefik.http.routers.rendezvous-secure.tls=true
      - traefik.http.routers.rendezvous-secure.tls.certresolver=myresolver
      # No auth middleware: the phones pairing have no credentials to present.
      # The six-character code over a ten-minute window is the only secret, and
      # server.js rate-limits per IP against anyone enumerating it.
      - traefik.http.routers.rendezvous-secure.middlewares=security-headers@docker,rate-limit@docker
      - traefik.http.routers.rendezvous.entrypoints=web
      - traefik.http.routers.rendezvous.middlewares=rendezvous-https-redirect
      - traefik.http.routers.rendezvous.rule=Host(`{{ rendezvous.domain }}`)
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:{{ rendezvous.port }}/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  timescaledb:
    image: timescale/timescaledb-ha:pg16
    container_name: web_timescaledb
    mem_limit: 2560m
    memswap_limit: 2560m
    cpus: 2.0
    # Sized for the 2.5 GB limit. These override the postgresql.conf that
    # timescaledb-tune wrote into the data directory at init (tuned for a
    # bigger host: shared_buffers ~2 GB, maintenance_work_mem ~1 GB and up to
    # 10 autovacuum workers, which got the server OOM-killed, TASK-096).
    command:
      - postgres
      - -c
      - shared_buffers=640MB
      - -c
      - effective_cache_size=1792MB
      - -c
      - maintenance_work_mem=256MB
      - -c
      - work_mem=8MB
      - -c
      - autovacuum_max_workers=3
      - -c
      - autovacuum_work_mem=64MB
      - -c
      - max_parallel_workers=2
      - -c
      - max_parallel_workers_per_gather=1
    networks:
      - grafana
    environment:
      - POSTGRES_USER={{ vault_timescale_pg_user }}
      - POSTGRES_PASSWORD_FILE=/run/secrets/timescale_superuser_password
      - POSTGRES_DB=timescale_home
      - TZ=Europe/Vienna
    secrets:
      - timescale_superuser_password
    ports:
      - "{{ wireguard.address }}:5432:5432"
    volumes:
      - "{{ docker.paths.data }}timescale/pgdata:/home/postgres/pgdata/data"
      - "{{ docker.paths.configs }}timescale/init_roles.sql:/docker-entrypoint-initdb.d/01_init_roles.sql:ro"
      - "{{ docker.paths.configs }}timescale/monitoring.sql:/docker-entrypoint-initdb.d/02_monitoring.sql:ro"
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ vault_timescale_pg_user }} -d timescale_home"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  loki:
    image: grafana/loki:3.5.0
    container_name: web_loki
    mem_limit: 512M
    cpus: 0.5
    expose:
      - 3100
    volumes:
      - "{{ docker.paths.configs }}loki/loki.yml:/etc/loki/loki.yml:ro"
      - "{{ docker.paths.data }}loki:/var/loki"
    command: -config.file=/etc/loki/loki.yml
    networks:
      - grafana
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:3100/ready || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: unless-stopped

  promtail:
    image: grafana/promtail:3.5.0
    container_name: web_promtail
    mem_limit: 256M
    cpus: 0.25
    volumes:
      - "{{ docker.paths.configs }}promtail/promtail.yml:/etc/promtail/promtail.yml:ro"
      - "{{ docker.paths.work }}promtail:/tmp"
    command: -config.file=/etc/promtail/promtail.yml
    networks:
      - grafana
      - socket_proxy
    depends_on:
      - loki
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'printf \"GET / HTTP/1.1\\n\\n\" > /dev/tcp/127.0.0.1/9080; exit $?;'"]
      interval: 20s
      retries: 30
      timeout: 10s
      start_period: 10s
    restart: unless-stopped

  postgres-exporter:
    image: prometheuscommunity/postgres-exporter:v0.19.1
    container_name: web_postgres-exporter
    mem_limit: 128M
    cpus: 0.25
    # The per-table collectors emit ~20 series for each of the ~2,300
    # hypertable chunks, which got the exporter OOM-killed every few minutes
    # after the TASK-051 rebuild. Nothing uses them.
    command:
      - --no-collector.stat_user_tables
      - --no-collector.statio_user_tables
    expose:
      - 9187
    environment:
      - DATA_SOURCE_URI=timescaledb:5432/timescale_home?sslmode=disable
      - DATA_SOURCE_USER=grafana_ro
      - DATA_SOURCE_PASS_FILE=/run/secrets/timescale_grafana_ro_password
      - PG_EXPORTER_EXTEND_QUERY_PATH=/etc/postgres_exporter/queries.yml
      - PG_EXPORTER_CONFIG_FILE=/etc/postgres_exporter/queries.yml
    secrets:
      - timescale_grafana_ro_password
    volumes:
      - "{{ docker.paths.configs }}postgres_exporter/queries.yml:/etc/postgres_exporter/queries.yml:ro"
    networks:
      - grafana
      - prometheus
    depends_on:
      timescaledb:
        condition: service_healthy
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:9187/metrics || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: unless-stopped

  sql-exporter:
    image: burningalchemist/sql_exporter:0.24.11
    container_name: web_sql-exporter
    read_only: true
    mem_limit: 64M
    cpus: 0.25
    command:
      - '--config.file=/etc/sql_exporter/sql_exporter.yml'
      - '--web.listen-address=:{{ sql_exporter.port }}'
    expose:
      - {{ sql_exporter.port }}
    volumes:
      - "{{ docker.paths.configs }}sql_exporter/sql_exporter.yml:/etc/sql_exporter/sql_exporter.yml:ro"
    environment:
      - TZ=Europe/Vienna
    networks:
      - grafana
      - prometheus
    depends_on:
      timescaledb:
        condition: service_healthy
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:{{ sql_exporter.port }}/healthz || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: unless-stopped

  photoprism-mariadb:
    image: mariadb:10.11.16
    container_name: photoprism-mariadb
    mem_limit: 512M
    restart: unless-stopped
    stop_grace_period: 5s
    security_opt:
      - no-new-privileges:true
    command: mariadbd --innodb-buffer-pool-size=512M --transaction-isolation=READ-COMMITTED --character-set-server=utf8mb4 --collation-server=utf8mb4_unicode_ci --max-connections=512 --innodb-rollback-on-timeout=OFF --innodb-lock-wait-timeout=120
    volumes:
      - "{{ docker.paths.data }}photoprism/database:/var/lib/mysql"
    secrets:
      - photoprism_db_password
      - photoprism_db_root_password
    environment:
      - MARIADB_AUTO_UPGRADE=1
      - MARIADB_INITDB_SKIP_TZINFO=1
      - MARIADB_DATABASE=photoprism
      - MARIADB_USER=photoprism
      - MARIADB_PASSWORD_FILE=/run/secrets/photoprism_db_password
      - MARIADB_ROOT_PASSWORD_FILE=/run/secrets/photoprism_db_root_password
      - TZ=Europe/Vienna
    networks:
      - photoprism
    labels:
      - autoheal=true
      - traefik.enable=false
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  photoprism:
    image: photoprism/photoprism:260305
    container_name: photoprism
    mem_limit: 2G
    depends_on:
      - photoprism-mariadb
      - reverse-proxy
    restart: unless-stopped
    stop_grace_period: 10s
    security_opt:
      - no-new-privileges:true
      - seccomp:{{ docker.paths.configs }}photoprism/seccomp.json
    expose:
      - 2342
    environment:
      - PHOTOPRISM_ADMIN_USER=admin
      - PHOTOPRISM_ADMIN_PASSWORD={{ vault_photoprism_admin_password }}
      - PHOTOPRISM_AUTH_MODE=password
      - PHOTOPRISM_SITE_URL=https://{{ photoprism.domain }}/
      - PHOTOPRISM_DISABLE_TLS=true
      - PHOTOPRISM_DEFAULT_TLS=false
      - PHOTOPRISM_ORIGINALS_LIMIT=5000
      - PHOTOPRISM_HTTP_COMPRESSION=gzip
      - PHOTOPRISM_LOG_LEVEL=info
      - PHOTOPRISM_READONLY=false
      - PHOTOPRISM_EXPERIMENTAL=false
      - PHOTOPRISM_DISABLE_CHOWN=false
      - PHOTOPRISM_DISABLE_WEBDAV=false
      - PHOTOPRISM_DISABLE_SETTINGS=false
      - PHOTOPRISM_DISABLE_TENSORFLOW=false
      - PHOTOPRISM_DISABLE_FACES=false
      - PHOTOPRISM_DISABLE_CLASSIFICATION=false
      - PHOTOPRISM_DISABLE_VECTORS=false
      - PHOTOPRISM_DISABLE_RAW=false
      - PHOTOPRISM_RAW_PRESETS=false
      - PHOTOPRISM_JPEG_QUALITY=85
      - PHOTOPRISM_DETECT_NSFW=false
      - PHOTOPRISM_UPLOAD_NSFW=true
      - PHOTOPRISM_DATABASE_DRIVER=mysql
      - PHOTOPRISM_DATABASE_SERVER=photoprism-mariadb:3306
      - PHOTOPRISM_DATABASE_NAME=photoprism
      - PHOTOPRISM_DATABASE_USER=photoprism
      - PHOTOPRISM_DATABASE_PASSWORD={{ vault_photoprism_db_password }}
      - PHOTOPRISM_SITE_CAPTION=AI-Powered Photos App
      - PHOTOPRISM_SITE_DESCRIPTION=
      - PHOTOPRISM_SITE_AUTHOR=
      - TZ=Europe/Vienna
    working_dir: "/photoprism"
    volumes:
      - "{{ docker.paths.work }}photoprism/originals:/photoprism/originals"
      - "{{ docker.paths.work }}photoprism/import:/photoprism/import"
      - "{{ docker.paths.data }}photoprism/storage:/photoprism/storage"
    networks:
      - proxy
      - photoprism
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.http.middlewares.photoprism-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.photoprism-secure.entrypoints=websecure
      - traefik.http.routers.photoprism-secure.rule=Host(`{{ photoprism.domain }}`)
      - traefik.http.routers.photoprism-secure.middlewares=security-headers@docker,rate-limit@docker
      - traefik.http.routers.photoprism-secure.tls=true
      - traefik.http.routers.photoprism-secure.tls.certresolver=myresolver
      - traefik.http.routers.photoprism.entrypoints=web
      - traefik.http.routers.photoprism.middlewares=photoprism-https-redirect
      - traefik.http.routers.photoprism.rule=Host(`{{ photoprism.domain }}`)
    healthcheck:
      test: ["CMD-SHELL", "photoprism", "status"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s

  conduit:
    image: matrixconduit/matrix-conduit:v0.10.12
    container_name: web_conduit
    mem_limit: 512M
    cpus: 0.5
    depends_on:
      - reverse-proxy
    expose:
      - {{ conduit.port }}
    volumes:
      - "{{ docker.paths.configs }}conduit/conduit.toml:/etc/conduit/conduit.toml:ro"
      - "{{ docker.paths.data }}conduit:/var/lib/matrix-conduit"
    environment:
      - CONDUIT_CONFIG=/etc/conduit/conduit.toml
      - TZ=Europe/Vienna
    networks:
      - proxy
    labels:
      - traefik.enable=true
      - traefik.http.middlewares.conduit-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.conduit-secure.entrypoints=websecure
      - traefik.http.routers.conduit-secure.rule=Host(`{{ conduit.domain }}`)
      - traefik.http.routers.conduit-secure.tls=true
      - traefik.http.routers.conduit-secure.tls.certresolver=myresolver
      - traefik.http.routers.conduit-secure.middlewares=security-headers@docker,rate-limit@docker
      - traefik.http.routers.conduit.entrypoints=web
      - traefik.http.routers.conduit.middlewares=conduit-https-redirect
      - traefik.http.routers.conduit.rule=Host(`{{ conduit.domain }}`)
    restart: unless-stopped

  picoclaw:
    image: docker.io/sipeed/picoclaw:v0.2.8-launcher
    container_name: web_picoclaw
    mem_limit: 512M
    cpus: 1.0
    depends_on:
      - reverse-proxy
    expose:
      - {{ picoclaw.port }}
      - {{ picoclaw_gw.port }}
    volumes:
      - "{{ docker.paths.data }}picoclaw:/root/.picoclaw"
    environment:
      - TZ=Europe/Vienna
      - PICOCLAW_LAUNCHER_TOKEN={{ vault_picoclaw_launcher_token }}
      - PICOCLAW_GATEWAY_HOST=0.0.0.0
    networks:
      - picoclaw_ui
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_picoclaw_ui
      - traefik.http.middlewares.picoclaw-https-redirect.redirectscheme.scheme=https
      - traefik.http.middlewares.picoclaw-gw-https-redirect.redirectscheme.scheme=https
      - traefik.http.services.picoclaw-launcher.loadbalancer.server.port={{ picoclaw.port }}
      - traefik.http.services.picoclaw-gateway.loadbalancer.server.port={{ picoclaw_gw.port }}
      - traefik.http.routers.picoclaw-secure.entrypoints=websecure
      - traefik.http.routers.picoclaw-secure.rule=Host(`{{ picoclaw.domain }}`)
      - traefik.http.routers.picoclaw-secure.service=picoclaw-launcher
      - traefik.http.routers.picoclaw-secure.tls=true
      - traefik.http.routers.picoclaw-secure.tls.certresolver=myresolver
      - traefik.http.routers.picoclaw-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.picoclaw.entrypoints=web
      - traefik.http.routers.picoclaw.middlewares=picoclaw-https-redirect
      - traefik.http.routers.picoclaw.rule=Host(`{{ picoclaw.domain }}`)
      - traefik.http.routers.picoclaw-gw-secure.entrypoints=websecure
      - traefik.http.routers.picoclaw-gw-secure.rule=Host(`{{ picoclaw_gw.domain }}`)
      - traefik.http.routers.picoclaw-gw-secure.service=picoclaw-gateway
      - traefik.http.routers.picoclaw-gw-secure.tls=true
      - traefik.http.routers.picoclaw-gw-secure.tls.certresolver=myresolver
      - traefik.http.routers.picoclaw-gw-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.picoclaw-gw.entrypoints=web
      - traefik.http.routers.picoclaw-gw.middlewares=picoclaw-gw-https-redirect
      - traefik.http.routers.picoclaw-gw.rule=Host(`{{ picoclaw_gw.domain }}`)
    restart: unless-stopped

  code-server:
    image: lscr.io/linuxserver/code-server:4.117.0-ls335
    container_name: web_code-server
    mem_limit: 4G
    cpus: 2.0
    depends_on:
      - reverse-proxy
    security_opt:
      - seccomp={{ docker.paths.configs }}code-server/seccomp.json
    shm_size: "1gb"
    expose:
      - {{ code_server.port }}
      - {{ expo.port }}
    volumes:
      - "{{ docker.paths.data }}code-server:/config"
      - "{{ docker.paths.configs }}code-server:/config/.config/code-server:ro"
      - "{{ docker.paths.configs }}code-server/custom-cont-init.d:/custom-cont-init.d:ro"
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/Vienna
      - PROXY_DOMAIN={{ code_server.domain }}
      - EXPO_PACKAGER_PROXY_URL=https://{{ expo.domain }}
      - DOCKER_MODS=linuxserver/mods:universal-package-install
      - INSTALL_PACKAGES=libglib2.0-0|libdbus-1-3|libatk1.0-0|libatk-bridge2.0-0|libcups2|libcairo2|libgtk-3-0|libgbm1|libasound2t64|openjdk-21-jdk-headless|unzip|wget|ca-certificates|lsof|tree|python3
      - ANDROID_HOME=/config/android-sdk
      - ANDROID_SDK_ROOT=/config/android-sdk
      - JAVA_HOME=/usr/lib/jvm/java-21-openjdk-amd64
    networks:
      - code_ui
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_code_ui
      - traefik.http.services.code-server.loadbalancer.server.port={{ code_server.port }}
      - traefik.http.services.expo.loadbalancer.server.port={{ expo.port }}
      - traefik.http.middlewares.code-server-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.code-server-secure.entrypoints=websecure
      - traefik.http.routers.code-server-secure.rule=Host(`{{ code_server.domain }}`)
      - traefik.http.routers.code-server-secure.tls=true
      - traefik.http.routers.code-server-secure.tls.certresolver=myresolver
      - traefik.http.routers.code-server-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.code-server-secure.service=code-server
      - traefik.http.routers.code-server.entrypoints=web
      - traefik.http.routers.code-server.middlewares=code-server-https-redirect
      - traefik.http.routers.code-server.rule=Host(`{{ code_server.domain }}`)
      - traefik.http.routers.code-server.service=code-server
      - traefik.http.middlewares.expo-https-redirect.redirectscheme.scheme=https
      - traefik.http.routers.expo-secure.entrypoints=websecure
      - traefik.http.routers.expo-secure.rule=Host(`{{ expo.domain }}`)
      - traefik.http.routers.expo-secure.tls=true
      - traefik.http.routers.expo-secure.tls.certresolver=myresolver
      - traefik.http.routers.expo-secure.service=expo
      - traefik.http.routers.expo.entrypoints=web
      - traefik.http.routers.expo.middlewares=expo-https-redirect
      - traefik.http.routers.expo.rule=Host(`{{ expo.domain }}`)
      - traefik.http.routers.expo.service=expo
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ code_server.port }}/healthz"]
      interval: 20s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: unless-stopped

  otterwiki:
    image: redimp/otterwiki:2.26.0
    container_name: web_otterwiki
    mem_limit: 256M
    cpus: 0.5
    depends_on:
      - reverse-proxy
      - authelia
    expose:
      - 80
    volumes:
      - "{{ docker.paths.data }}otterwiki:/app-data"
      - "{{ docker.paths.configs }}otterwiki/settings.cfg:/config/settings.cfg:ro"
    environment:
      - TZ=Europe/Vienna
      - OTTERWIKI_SETTINGS=/config/settings.cfg
      - NGINX_MAX_UPLOAD={{ otterwiki.max_upload }}
      # Git config for every git call in the container: pulls from GitHub
      # only fast-forward. A merge could stop on a conflict and leave
      # conflict markers in the wiki's working tree.
      - GIT_CONFIG_COUNT=1
      - GIT_CONFIG_KEY_0=pull.ff
      - GIT_CONFIG_VALUE_0=only
    # Otterwiki trusts the Remote-* headers blindly, so it must only be
    # reachable through Traefik. Its own network keeps every other container
    # on web_proxy from talking to it with forged headers.
    networks:
      - wiki
    labels:
      - autoheal=true
      - traefik.enable=true
      - traefik.docker.network=web_wiki
      - traefik.http.middlewares.otterwiki-https-redirect.redirectscheme.scheme=https
      - traefik.http.services.otterwiki.loadbalancer.server.port=80
      - traefik.http.routers.otterwiki-secure.entrypoints=websecure
      - traefik.http.routers.otterwiki-secure.rule=Host(`{{ otterwiki.domain }}`)
      - traefik.http.routers.otterwiki-secure.service=otterwiki
      - traefik.http.routers.otterwiki-secure.tls=true
      - traefik.http.routers.otterwiki-secure.tls.certresolver=myresolver
      - traefik.http.routers.otterwiki-secure.middlewares=auth@docker,security-headers@docker,rate-limit@docker
      - traefik.http.routers.otterwiki.entrypoints=web
      - traefik.http.routers.otterwiki.middlewares=otterwiki-https-redirect
      - traefik.http.routers.otterwiki.rule=Host(`{{ otterwiki.domain }}`)
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost/-/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: unless-stopped

networks:
  proxy:
    name: web_proxy
    ipam:
      config:
        - subnet: 172.20.0.0/24
  socket_proxy:
    internal: true
  grafana:
  prometheus:
  photoprism:
  wiki:
    name: web_wiki
  grafana_ui:
    name: web_grafana_ui
    ipam:
      config:
        - subnet: 172.20.1.0/24
          ip_range: 172.20.1.128/25
  monitoring_ui:
    name: web_monitoring_ui
  code_ui:
    name: web_code_ui
  picoclaw_ui:
    name: web_picoclaw_ui

secrets:
  timescale_superuser_password:
    file: "{{ docker_base_path }}/secrets/timescale_superuser_password"
  grafana_pg_password:
    file: "{{ docker_base_path }}/secrets/grafana_pg_password"
  smtp_password:
    file: "{{ docker_base_path }}/secrets/smtp_password"
  photoprism_db_password:
    file: "{{ docker_base_path }}/secrets/photoprism_db_password"
  photoprism_db_root_password:
    file: "{{ docker_base_path }}/secrets/photoprism_db_root_password"
  authelia_jwt_secret:
    file: "{{ docker_base_path }}/secrets/authelia_jwt_secret"
  authelia_session_secret:
    file: "{{ docker_base_path }}/secrets/authelia_session_secret"
  authelia_storage_encryption_key:
    file: "{{ docker_base_path }}/secrets/authelia_storage_encryption_key"
