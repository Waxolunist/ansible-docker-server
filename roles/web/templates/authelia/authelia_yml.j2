###############################################################
#                   Authelia configuration                    #
###############################################################

server:
  address: tcp://0.0.0.0:{{ authelia.port }}/

log:
  level: debug

totp:
  issuer: {{ topleveldomain }}

authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2
      argon2:
        variant: argon2id

access_control:
  default_policy: deny
  # First match wins. The wiki rules must come before the wildcard, which
  # would otherwise let every full-access user in regardless of wiki group.
  rules:
    - domain: "{{ otterwiki.domain }}"
      policy: one_factor
      subject:
        - "group:{{ otterwiki.user_group }}"
        - "group:{{ otterwiki.admin_group }}"
    - domain: "{{ otterwiki.domain }}"
      policy: deny
    - domain: "*.{{ topleveldomain }}"
      policy: one_factor
      subject:
{% for group in authelia_full_access_groups %}
        - "group:{{ group }}"
{% endfor %}

session:
  name: authelia_session
  expiration: 1h
  inactivity: 5m
  cookies:
    - domain: {{ topleveldomain }}
      authelia_url: https://{{ authelia.domain }}
      default_redirection_url: https://{{ topleveldomain }}

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /var/db.sqlite3

notifier:
  filesystem:
    filename: /notifications/notification.txt