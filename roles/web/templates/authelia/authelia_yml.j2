###############################################################
#                   Authelia configuration                    #
###############################################################

server:
  address: tcp://0.0.0.0:{{ authelia.port }}/

log:
  level: debug

totp:
  issuer: {{ topleveldomain }}

authentication_backend:
  # Authelia owns the users database: users reset and change their own
  # passwords, and scripts/authelia_user.sh adds and disables users.
  password_reset:
    disable: false
  password_change:
    disable: false
  # How often a logged-in user's details are re-read, so a disabled user or a
  # removed group takes effect within a minute instead of at session end.
  refresh_interval: 1m
  file:
    path: /users/users_database.yml
    # Picks up edits made by scripts/authelia_user.sh without a restart,
    # which would end every session (they are held in memory).
    watch: true
    password:
      algorithm: argon2
      argon2:
        variant: argon2id

# Users now choose their own passwords, and one password opens every service.
# Score 3 of 4 rejects dictionary words and common patterns.
password_policy:
  zxcvbn:
    enabled: true
    min_score: 3

access_control:
  default_policy: deny
  # First match wins. The wiki rules must come before the wildcard, which
  # would otherwise let every full-access user in regardless of wiki group.
  rules:
    - domain: "{{ otterwiki.domain }}"
      policy: one_factor
      subject:
        - "group:{{ otterwiki.user_group }}"
        - "group:{{ otterwiki.admin_group }}"
    - domain: "{{ otterwiki.domain }}"
      policy: deny
    - domain: "*.{{ topleveldomain }}"
      policy: one_factor
      subject:
{% for group in authelia_full_access_groups %}
        - "group:{{ group }}"
{% endfor %}

session:
  name: authelia_session
  expiration: 1h
  inactivity: 5m
  cookies:
    - domain: {{ topleveldomain }}
      authelia_url: https://{{ authelia.domain }}
      default_redirection_url: https://{{ topleveldomain }}

regulation:
  max_retries: 3
  find_time: 2m
  ban_time: 5m

storage:
  local:
    path: /var/db.sqlite3

# Sends the one-time codes for identity verification (2FA enrollment,
# elevated sessions). Same Gmail account and app password as Grafana; the
# password comes from AUTHELIA_NOTIFIER_SMTP_PASSWORD_FILE.
notifier:
  # The startup check logs in to Gmail and makes Authelia refuse to start if
  # that fails. Authelia guards every service, so a revoked app password
  # would lock out all of them; without the check only sending mail fails.
  disable_startup_check: true
  smtp:
    address: submission://smtp.gmail.com:587
    username: {{ vault_smtp_server_user }}
    # Gmail rewrites any other From address to the authenticated account.
    sender: "Authelia <{{ vault_smtp_server_user }}>"
    subject: "[{{ topleveldomain }}] {title}"