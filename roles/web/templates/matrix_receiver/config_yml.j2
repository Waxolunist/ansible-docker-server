http:
  port: [[ matrix_receiver.port ]]
  alerts-path-prefix: /alerts
  metrics-enabled: true
  metrics-path: /metrics
  basic-username: alertmanager
  basic-password: [[ vault_matrix_alerts_receiver_password | to_json ]]

matrix:
  homeserver-url: "http://conduit:[[ conduit.port ]]"
  user-id: [[ vault_matrix_alerts_user | to_json ]]
  access-token: [[ vault_matrix_alerts_token | to_json ]]
  room-mapping:
{% for area in alerting.areas %}
    [[ area ]]: [[ lookup('vars', 'vault_matrix_room_' ~ area) | to_json ]]
{% endfor %}

templating:
  computed-values:
    - values:
        color: "#3b82f6"
        icon: "ℹ️"
    - values:
        color: "#f59e0b"
        icon: "⚠️"
      when-matching-labels:
        severity: warning
    - values:
        color: "#dc2626"
        icon: "🚨"
      when-matching-labels:
        severity: critical
    - values:
        color: "#16a34a"
        icon: "✅"
      when-matching-status: resolved

  firing-template: |
    {{ if eq .Alert.Labels.alertname "CarStarted" }}
    <p>🚗 <strong>Car has started</strong> at {{ .Alert.StartsAt.Local.Format "15:04" }}</p>
    {{ else }}
    <p>
    {{ if eq .Alert.Labels.severity "critical" }}@room{% for user in vault_matrix_alerts_mention_users | default([]) %} <a href="https://matrix.to/#/[[ user ]]">[[ user ]]</a>{% endfor %}<br>{{ end }}
    {{ .ComputedValues.icon }} <strong><font color="{{ .ComputedValues.color }}">FIRING · {{ .Alert.Labels.severity | ToUpper }}</font></strong><br>
    <strong>{{ .Alert.Annotations.summary }}</strong><br>
    {{ .Alert.Annotations.description }}<br>
    Since {{ .Alert.StartsAt.Local.Format "Mon 02.01. 15:04" }}<br>
    {{ if .Alert.Labels.name }}Container <code>{{ .Alert.Labels.name }}</code><br>{{ else if .Alert.Labels.instance }}Host <code>{{ .Alert.Labels.instance }}</code><br>{{ end }}
    {{ if .Alert.Annotations.dashboard }}<a href="{{ .Alert.Annotations.dashboard }}">Dashboard</a> · {{ end }}{{ if .Alert.Annotations.runbook }}<a href="{{ .Alert.Annotations.runbook }}">Runbook</a> · {{ end }}<a href="{{ .SilenceURL }}">Silence</a>
    </p>
    {{ end }}

  resolved-template: |
    {{ if eq .Alert.Labels.alertname "CarStarted" }}
    <p>🅿️ <strong>Car has stopped</strong> at {{ .Alert.EndsAt.Local.Format "15:04" }}, after {{ (.Alert.EndsAt.Sub .Alert.StartsAt).Round 60000000000 }}</p>
    {{ else }}
    <p>
    {{ .ComputedValues.icon }} <strong><font color="{{ .ComputedValues.color }}">RESOLVED</font></strong><br>
    <strong>{{ .Alert.Annotations.summary }}</strong><br>
    Fired for {{ (.Alert.EndsAt.Sub .Alert.StartsAt).Round 60000000000 }}, since {{ .Alert.StartsAt.Local.Format "Mon 02.01. 15:04" }}
    </p>
    {{ end }}
