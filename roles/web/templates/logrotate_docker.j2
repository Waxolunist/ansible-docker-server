{{ docker.paths.logs }}*.log {{ docker.paths.logs }}*/*.log {{ docker.paths.logs }}*/*/*.log {
    daily
    rotate {{ docker_log_retention_days }}
    maxage {{ docker_log_retention_days }}
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    dateext
    dateformat -%Y-%m-%d
    su root root
}
