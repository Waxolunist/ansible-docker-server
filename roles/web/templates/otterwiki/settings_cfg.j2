###############################################################
#                   Otterwiki configuration                   #
###############################################################

DEBUG = False
SECRET_KEY = '{{ vault_otterwiki_secret_key }}'
REPOSITORY = '/app-data/repository'
SQLALCHEMY_DATABASE_URI = 'sqlite:////app-data/db.sqlite'

SITE_NAME = '{{ otterwiki.site_name }}'
ROBOTS_TXT = 'disallow'

# Authentication is delegated to Authelia through Traefik's forwardAuth
# middleware, which overwrites these headers on every request. Otterwiki has
# no login of its own in this mode.
AUTH_METHOD = 'PROXY_HEADER'
# Remote-User rather than Remote-Name for the git author: Otterwiki decodes
# headers as latin-1, so display names with umlauts end up mangled in the
# commit history.
AUTH_HEADERS_USERNAME = 'Remote-User'
AUTH_HEADERS_EMAIL = 'Remote-Email'
AUTH_HEADERS_PERMISSIONS = 'Remote-Groups'

# PROXY_HEADER hides Otterwiki's own logout, so the sidebar links to
# Authelia's instead. That ends the session for every service, as they all
# share one cookie, and rd leads back to the wiki's login page. A menu saved
# in the admin UI goes to the database and replaces this one.
SIDEBAR_CUSTOM_MENU = '[{"title": "Logout", "link": "https://{{ authelia.domain }}/logout?rd=https://{{ otterwiki.domain }}/"}]'

# Authelia groups mapped onto Otterwiki permissions. Admins need READ, WRITE
# and UPLOAD as well, the flags are independent.
AUTH_ROLES_READ = '{{ otterwiki.user_group }} {{ otterwiki.admin_group }}'
AUTH_ROLES_WRITE = '{{ otterwiki.user_group }} {{ otterwiki.admin_group }}'
AUTH_ROLES_UPLOAD = '{{ otterwiki.user_group }} {{ otterwiki.admin_group }}'
AUTH_ROLES_ADMIN = '{{ otterwiki.admin_group }}'

# Pushes the repository after every change, so a copy survives losing the
# server. A plain push, not a force push: if anything else ever pushes to the
# remote, the wiki's pushes are rejected until that is sorted out. Otterwiki
# runs ssh with host key checking off. Settings saved in the admin UI's
# repository management go to the database and replace these.
GIT_REMOTE_PUSH_ENABLED = True
GIT_REMOTE_PUSH_URL = '{{ otterwiki.push_url }}'
GIT_REMOTE_PUSH_PRIVATE_KEY = '''{{ vault_otterwiki_push_private_key }}'''

# Ignored by PROXY_HEADER, set anyway so that a fallback to the built-in auth
# never exposes the wiki to anonymous visitors.
READ_ACCESS = 'APPROVED'
WRITE_ACCESS = 'APPROVED'
ATTACHMENT_ACCESS = 'APPROVED'
DISABLE_REGISTRATION = True
