[Interface]
Address = {{ wireguard.address }}/{{ wireguard.network.split('/')[1] }}
ListenPort = {{ wireguard.port }}
PrivateKey = {{ vault_wireguard_private_key }}
{% for peer in wireguard.peers %}

[Peer]
# {{ peer.name }}
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.address }}/32
{% endfor %}
